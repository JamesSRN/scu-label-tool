# Patient data / PHI - never commit
*.xlsm
*.xlsx
*.xls
*.csv

# Dispense-log CSV archive (PHI - local only, never commit)
dispense-log/

# Excel lock files
~$*

# Local backups
_backups/

# Throwaway build/debug scratch images and generated blobs in tools\
tools/_*
tools/*.generated.txt

# Release ZIPs are attached to GitHub Releases, not committed (may bundle the workbook)
dist/

# Clean template MAY be tracked despite the *.xlsm rule above (no PHI). Uncomment the
# exception if you move a PHI-free template into templates\ (see tools/reorg-v2.ps1):
# !templates/Template_MedicationDispensing.xlsm
