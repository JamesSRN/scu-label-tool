# SCU Dispensary Label Tool
# Patient data / PHI - never commit
# NOTE: *.xlsm is intentionally NOT ignored - MedicationDispensing.xlsm auto-wipes
# all patient data + the Log on close, so the tracked copy carries no PHI. Commit a
# freshly-rebuilt (closed) workbook. Other spreadsheet exports stay ignored.
*.xlsx
*.xls
*.csv

# Dispense-log CSV archive (PHI - local only, never commit)
dispense-log/

# Excel lock files
~$*

# Local backups
_backups/

# Throwaway build/debug scratch images and generated blobs in tools\
tools/_*
tools/*.generated.txt

# Release ZIPs are attached to GitHub Releases, not committed (may bundle the workbook)
dist/

# (The workbook itself is now tracked - see the *.xlsm note at the top of this file.)

# Local clone of the Lab GitHub repo (separate project; do not commit)
_lab_work/
